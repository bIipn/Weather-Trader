# Copy to .env (never commit it). Only needed for demo/live trading.

# paper | demo | live
WXBOT_MODE=paper

# Kalshi API key (kalshi.com → Account & security → API keys; demo keys come from demo.kalshi.co)
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=~/.kalshi/wxbot.pem
# ...or paste the PEM itself (useful for CI secrets):
# KALSHI_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Optional extra forecast source — the same provider as the Tomorrow.io weather connector
TOMORROW_API_KEY=

# Optional: paid Open-Meteo key (their free tier is for non-commercial use)
OPEN_METEO_API_KEY=

# Contact string sent in the User-Agent (api.weather.gov asks for one)
WXBOT_CONTACT=you@example.com
